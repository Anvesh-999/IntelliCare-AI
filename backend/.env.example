# =============================================================================
# IntelliCare AI — Backend Environment Configuration Template
# =============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# MongoDB Database Connection String (Local Community or Cloud Atlas)
# Example: mongodb://localhost:27017/intellicare OR mongodb+srv://<user>:<password>@cluster.mongodb.net/intellicare
MONGO_URI=mongodb://localhost:27017/intellicare

# JWT Authentication Secret Key (Generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_minimum_32_chars_here

# Microservice URL for Python FastAPI AI Service
AI_SERVICE_URL=http://localhost:8000

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://intelli-care-ai-dalt.vercel.app
