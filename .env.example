# =============================================================================
# IntelliCare AI — Full-Stack Project Environment Template
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Express Backend Service (Port 5000)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/intellicare
JWT_SECRET=your_jwt_secret_key_minimum_32_chars_here
AI_SERVICE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://intelli-care-ai-dalt.vercel.app

# -----------------------------------------------------------------------------
# 2. FastAPI AI Microservice (Port 8000)
# -----------------------------------------------------------------------------
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=25.0
LLM_MAX_RETRIES=3
INTERNAL_SERVICE_TOKEN=intellicare_internal_ai_secret_token_2026

# -----------------------------------------------------------------------------
# 3. React Frontend Application (Port 3000)
# -----------------------------------------------------------------------------
VITE_API_BASE=http://localhost:5000/api
