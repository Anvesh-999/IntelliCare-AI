# =============================================================================
# IntelliCare AI — FastAPI AI Microservice Environment Configuration
# =============================================================================

# Server Network Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# LLM Provider Configuration
# Supported: "gemini", "mock" (for offline unit testing)
LLM_PROVIDER=gemini

# Google Gemini API Credentials (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Generation Hyperparameters
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=25.0
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY_SECONDS=1.0

# Security, CORS, & Internal Service Authentication
MAX_INPUT_LENGTH=4000
INTERNAL_SERVICE_TOKEN=intellicare_internal_ai_secret_token_2026
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5173,https://intelli-care-ai-dalt.vercel.app
